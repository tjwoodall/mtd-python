{
  "address-lookup": {
    "1": {
      "0": {
        "components": {
          "securitySchemes": {
            "Application-Restricted": {
              "description": "HMRC supports OAuth 2.0 for authenticating application restricted API requests using an OAuth 2.0 Bearer Token in the AUTHORIZATION header.\nSee https://developer.service.hmrc.gov.uk/api-documentation/docs/authorisation/application-restricted-endpoints for details.\n",
              "flows": {
                "clientCredentials": {
                  "scopes": {},
                  "tokenUrl": "https://api.service.hmrc.gov.uk/oauth/token"
                }
              },
              "type": "oauth2"
            }
          }
        },
        "info": {
          "contact": {},
          "description": "# Overview\nThis API enables your application to lookup the full address for a UK postcode. The results can be narrowed down by providing an optional filter, e.g. \"21 High Street\".\nAddress data is provided by Ordnance Survey.\n",
          "title": "Address Verification",
          "version": "1.0"
        },
        "openapi": "3.0.3",
        "paths": {
          "/lookup": {
            "post": {
              "deprecated": false,
              "description": "Lookup of postal and BFPO (British Forces Post Office) address details within the UK\n",
              "operationId": "AddressVerificationLookup",
              "parameters": [],
              "requestBody": {
                "content": {
                  "application/json": {
                    "example": {
                      "filter": "The Rectory",
                      "postcode": "AA1 1ZZ"
                    },
                    "schema": {
                      "$schema": "http://json-schema.org/draft-07/schema#",
                      "title": "Root",
                      "type": "object",
                      "required": [
                        "postcode"
                      ],
                      "properties": {
                        "postcode": {
                          "title": "Postcode",
                          "description": "Full postcode to search for, all uppercase. The internal space may be omitted",
                          "type": "string",
                          "example": "AA1 1ZZ"
                        },
                        "filter": {
                          "title": "Filter",
                          "description": "Refine the search results further based on house number or street name",
                          "type": "string",
                          "example": "1 High Street"
                        }
                      }
                    }
                  }
                },
                "description": "",
                "required": true
              },
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": [
                        {
                          "address": {
                            "country": {
                              "code": "GB",
                              "name": "United Kingdom"
                            },
                            "lines": [
                              "Test House",
                              "The Tests"
                            ],
                            "postcode": "BB00 0BB",
                            "subdivision": {
                              "code": "GB-ENG",
                              "name": "England"
                            },
                            "town": "Test Town"
                          },
                          "administrativeArea": "TEST COUNTY",
                          "id": "GB200000706253",
                          "language": "en",
                          "localCustodian": {
                            "code": 1760,
                            "name": "Test Valley"
                          },
                          "location": [
                            50.9986451,
                            -1.4690977
                          ],
                          "organisation": "Some Company",
                          "parentUprn": 200000706251,
                          "uprn": 200000706253,
                          "usrn": 300000706253
                        }
                      ],
                      "schema": {
                        "$schema": "http://json-schema.org/draft-04/schema#",
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 40
                            },
                            "uprn": {
                              "description": "Unique property reference number, up to 12 digits",
                              "type": "number",
                              "minimum": 0
                            },
                            "parentUprn": {
                              "description": "Unique property reference number, up to 12 digits",
                              "type": "number",
                              "minimum": 0
                            },
                            "usrn": {
                              "description": "Unique property reference number, up to 12 digits",
                              "type": "number",
                              "minimum": 0
                            },
                            "organisation": {
                              "description": "Organisation associated with this address, if any",
                              "type": "string",
                              "minLength": 0,
                              "maxLength": 60
                            },
                            "address": {
                              "description": "Contains a UK-based address",
                              "type": "object",
                              "properties": {
                                "lines": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 35
                                  },
                                  "minItems": 1,
                                  "maxItems": 3
                                },
                                "town": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 35
                                },
                                "postcode": {
                                  "description": "the outcode, incode combination specified for the UK by Royal Mail",
                                  "type": "string",
                                  "pattern": "^[A-Z]{1,2}[0-9][0-9A-Z]? [0-9][A-Z]{2}$"
                                },
                                "subdivision": {
                                  "type": "object",
                                  "properties": {
                                    "code": {
                                      "description": "the ISO3166-2 subdivision - these are home nations, regions, departments, states, l\u00e4nder etc as appropriate",
                                      "type": "string",
                                      "minLength": 2,
                                      "maxLength": 6
                                    },
                                    "name": {
                                      "description": "printable name of the country",
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 35
                                    }
                                  },
                                  "additionalProperties": false,
                                  "required": [
                                    "code",
                                    "name"
                                  ]
                                },
                                "country": {
                                  "type": "object",
                                  "properties": {
                                    "code": {
                                      "description": "UK Country Register 2-letter code (like ISO3166-1), e.g. 'GB' (note that 'GB' is the official code for UK although 'UK' is an official synonym and may be used instead)",
                                      "type": "string",
                                      "minLength": 2,
                                      "maxLength": 2
                                    },
                                    "name": {
                                      "description": "printable name of the country",
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 35
                                    }
                                  },
                                  "additionalProperties": false,
                                  "required": [
                                    "code",
                                    "name"
                                  ]
                                }
                              },
                              "additionalProperties": false,
                              "required": [
                                "lines",
                                "town",
                                "postcode",
                                "country"
                              ]
                            },
                            "localCustodian": {
                              "description": "The local custodian responsible for this address",
                              "type": "object",
                              "properties": {
                                "code": {
                                  "description": "UK Local Custodian Code",
                                  "type": "number",
                                  "minimum": 0
                                },
                                "name": {
                                  "description": "Name of the UK Local Custodian",
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "code",
                                "name"
                              ]
                            },
                            "location": {
                              "type": "array",
                              "items": {
                                "type": "number",
                                "minimum": -180,
                                "maximum": 180
                              },
                              "minItems": 2,
                              "maxItems": 2
                            },
                            "language": {
                              "description": "ISO639-1 code, e.g. 'en' for English",
                              "type": "string",
                              "minLength": 2,
                              "maxLength": 2
                            },
                            "administrativeArea": {
                              "description": "Local council or authority",
                              "type": "string"
                            },
                            "poBox": {
                              "description": "Post Office Box number",
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 255
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "uprn",
                            "address",
                            "language"
                          ]
                        }
                      }
                    }
                  },
                  "description": "",
                  "headers": {}
                },
                "400": {
                  "description": "The request was invalid, e.g the postcode is not well formed.\n"
                },
                "401": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "MISSING_CREDENTIALS",
                              "INVALID_CREDENTIALS",
                              "UNAUTHORIZED",
                              "INCORRECT_ACCESS_TOKEN_TYPE"
                            ]
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "type": "object",
                        "example": {
                          "code": "MISSING_CREDENTIALS",
                          "message": "Authentication information is not provided"
                        }
                      }
                    }
                  },
                  "description": "UNAUTHORISED Response"
                },
                "403": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "HTTPS_REQUIRED",
                              "RESOURCE_FORBIDDEN",
                              "INVALID_SCOPE",
                              "FORBIDDEN"
                            ]
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "type": "object",
                        "example": {
                          "code": "RESOURCE_FORBIDDEN",
                          "message": "The application is not subscribed to the API which it is attempting to invoke"
                        }
                      }
                    }
                  },
                  "description": "UNAUTHORISED Response"
                },
                "404": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "MATCHING_RESOURCE_NOT_FOUND"
                            ]
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "type": "object",
                        "example": {
                          "code": "MATCHING_RESOURCE_NOT_FOUND",
                          "message": "No endpoint for the request path"
                        }
                      }
                    }
                  },
                  "description": "UNAUTHORISED Response"
                },
                "405": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "METHOD_NOT_ALLOWED"
                            ]
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "type": "object",
                        "example": {
                          "code": "METHOD_NOT_ALLOWED",
                          "message": "Request method must be one of GET, PUT, POST, PATCH, DELETE or OPTIONS"
                        }
                      }
                    }
                  },
                  "description": "UNAUTHORISED Response"
                },
                "406": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "ACCEPT_HEADER_INVALID"
                            ]
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "type": "object",
                        "example": {
                          "code": "ACCEPT_HEADER_INVALID",
                          "message": "Missint or invalid Accept header"
                        }
                      }
                    }
                  },
                  "description": "UNAUTHORISED Response"
