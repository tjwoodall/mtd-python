                  "description": "UNAUTHORISED Response"
                },
                "501": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "NOT_IMPLEMENTED"
                            ]
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "type": "object",
                        "example": {
                          "code": "NOT_IMPLEMENTED",
                          "message": "API not implemented or deployed"
                        }
                      }
                    }
                  },
                  "description": "UNAUTHORISED Response"
                },
                "503": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "SERVER_ERROR",
                              "SCHEDULED_MAINTENANCE"
                            ]
                          },
                          "message": {
                            "type": "string"
                          }
