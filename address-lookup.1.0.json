                            "type": "string"
                          }
                        },
                        "type": "object",
                        "example": {
                          "code": "GATEWAY_TIMEOUT",
                          "message": "Request timed out"
                        }
                      }
                    }
                  },
                  "description": "UNAUTHORISED Response"
                }
              },
              "security": [
                {
                  "Application-Restricted": []
                }
              ],
              "summary": "Lookup address"
            }
          }
        },
        "servers": [
