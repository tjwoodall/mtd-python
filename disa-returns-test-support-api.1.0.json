                                "title": "Detailed Message",
                                "type": "string",
                                "description": "Message describing the details of the validation error."
                              }
                            },
                            "example": {
                              "code": "EMPTY_PAYLOAD",
                              "message": "The payload is empty. Please ensure the request body contains a valid JSON payload before resubmitting."
                            }
                          },
                          {
                            "title": "Bad Request (Field Specific)",
                            "type": "object",
                            "properties": {
                              "code": {
                                "title": "Validation Failure",
                                "type": "string",
                                "description": "Code indicating the type of error.",
                                "enum": [
                                  "VALIDATION_FAILURE"
                                ]
                              },
                              "message": {
                                "title": "Message",
                                "type": "string",
                                "description": "Human-readable message outlining the error.",
                                "example": "Bad request"
                              },
                              "errors": {
                                "title": "Errors",
                                "type": "array",
                                "description": "Array of errors outlining issues found in the request body.",
                                "items": {
                                  "anyOf": [
                                    {
                                      "title": "Bad Request Item",
                                      "type": "object",
                                      "properties": {
                                        "code": {
                                          "title": "Validation Failure",
                                          "type": "string",
                                          "description": "Code indicating the type of error.",
                                          "enum": [
                                            "MISSING_FIELD",
                                            "VALIDATION_ERROR"
                                          ]
                                        },
                                        "message": {
                                          "title": "Message",
                                          "type": "string",
                                          "description": "Human-readable message outlining the error.",
                                          "example": "This field is required"
                                        },
                                        "path": {
                                          "title": "Path",
