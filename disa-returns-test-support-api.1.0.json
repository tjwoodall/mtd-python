      "0": {
        "components": {
          "securitySchemes": {
            "User-Restricted": {
              "description": "HMRC uses OAuth 2.0 Bearer tokens for authentication. Include the token in the AUTHORIZATION header of user-restricted API requests.\nSee https://developer.service.hmrc.gov.uk/api-documentation/docs/authorisation/user-restricted-endpoints for details.\n",
              "flows": {
                "authorizationCode": {
                  "authorizationUrl": "https://api.service.hmrc.gov.uk/oauth/authorize",
                  "refreshUrl": "https://api.service.hmrc.gov.uk/oauth/refresh",
                  "scopes": {
                    "write:isa-returns": "submit data to the api"
                  },
                  "tokenUrl": "https://api.service.hmrc.gov.uk/oauth/token"
                }
              },
              "type": "oauth2"
            }
          }
        },
        "info": {
          "description": "# Overview\n\nThe ISA Returns Test Support API simulates specific behaviours of the live ISA Returns API service to support the integration testing in the sandbox environment.\n\nUse this API to configure test scenarios for the ISA Returns API, including:\n\n- initiation of test reconciliation reports\n- temporary override of the reporting window\n\n\n# Integration requirements\n\nThe integration requirements are as follows:\n\n- REST API using JSON over HTTPS\n- authentication uses the OAuth 2.0 authorization code grant\n- all API calls require an HMRC-assigned unique identifier (Z-Reference) for each approved ISA manager\n\n# Support\n\nBefore contacting us, find out if there is planned API downtime or a technical issue by checking \n[HMRC API Platform Status](https://api-platform-status.production.tax.service.gov.uk/).\n\nFor support with onboarding, the API access, or the \n[HMRC Developer sandbox](https://developer.service.hmrc.gov.uk/api-documentation/docs/testing) \nqueries, submit your request using the \n[online support form](https://developer.service.hmrc.gov.uk/devhub-support/start) \nor email your queries to [SDSTeam@hmrc.gov.uk](mailto:SDSTeam@hmrc.gov.uk).\n\nWhen submitting a request, users should provide details of any available error information to help with the \ntroubleshooting and resolution of the issue.\n",
          "title": "ISA Returns Test Support",
          "version": "1.0.0"
        },
        "openapi": "3.0.3",
        "paths": {
          "/monthly/{zReference}/reconciliation": {
            "post": {
              "description": "Use the \u2018Generate test reconciliation report\u2019 endpoint to trigger the generation of a test reconciliation report \nfor the ISA Returns API.\n\nThe API request allows you to specify the number of occurrences for each of the following supported error types:\n\n- oversubscriptions\n- trace and match failures\n- eligibility failures\n  \nDepending on the notification process selected, you will either be notified via \n[Push Pull Notifications Service (PPNS)](https://developer.service.hmrc.gov.uk/api-documentation/docs/api/service/push-pull-notifications-api/1.0) \nusing the callback URL configured while subscribing to the ISA Returns API or you can query the PPNS API directly \nusing the box ID. The reconciliation report shows the rejected records, including any error messages where \napplicable. Your application can then use the relevant ISA Returns API endpoint to retrieve and process the \ngenerated results.\n\nThis allows you to test the notification flow and retrieval of the reconciliation report before integrating with \nthe live service.\n\nNote: Each sample reconciliation report has an upper threshold of 2000 simulated errors per report per \nZ-Reference. Attempts to exceed this limit will result in an error.  \n",
              "operationId": "generateTestReconciliationReport",
              "parameters": [
                {
                  "description": "A unique identifier assigned by HMRC to each approved ISA manager. Format: 'Zxxxx'.\n",
                  "explode": false,
                  "in": "path",
                  "name": "zReference",
                  "required": true,
                  "schema": {
                    "pattern": "^[z|Z][0-9]{4}$",
                    "type": "string",
                    "example": "Z1234"
                  },
                  "style": "simple"
                },
                {
                  "in": "header",
                  "name": "Accept",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "enum": [
                      "application/vnd.hmrc.1.0+json"
                    ]
                  }
                },
                {
                  "description": "Bearer token for authentication.",
                  "in": "header",
                  "name": "Authorization",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "title": "Report Description (Simple)",
                      "type": "object",
                      "required": [
                        "oversubscribed",
                        "traceAndMatch",
                        "failedEligibility"
                      ],
                      "properties": {
                        "oversubscribed": {
                          "type": "number",
                          "description": "Number of simulated oversubscription errors to include in the callback.",
                          "pattern": "$\\d^"
                        },
                        "traceAndMatch": {
                          "type": "number",
                          "description": "Number of simulated trace and match errors to include in the callback.",
                          "pattern": "$\\d^"
                        },
                        "failedEligibility": {
                          "type": "number",
                          "description": "Number of simulated eligibility errors to include in the callback.",
                          "pattern": "$\\d^"
                        }
                      }
                    }
                  }
                },
                "required": true
              },
              "responses": {
                "204": {
                  "description": "Submission accepted. No content returned."
                },
