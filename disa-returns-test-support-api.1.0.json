          "/monthly/{zReference}/reporting-window-override": {
            "put": {
              "description": "Configure a reporting window for the authenticated Z-Reference. The override lasts for one hour and replaces \nany existing override for that Z-Reference.\n\nThis operation does not change the system clock. When the override expires, normal reporting-period validation \nresumes.\n",
              "operationId": "setReportingWindowOverride",
              "parameters": [
                {
                  "description": "A unique identifier assigned by HMRC to each approved ISA manager. Format: 'Zxxxx'.",
                  "in": "path",
                  "name": "zReference",
                  "required": true,
                  "schema": {
                    "pattern": "^[zZ][0-9]{4}$",
                    "type": "string",
                    "example": "Z1234"
                  }
                },
                {
                  "in": "header",
                  "name": "Accept",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "enum": [
                      "application/vnd.hmrc.1.0+json"
                    ]
                  }
                },
                {
                  "description": "Bearer token for authentication.",
                  "in": "header",
                  "name": "Authorization",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "requestBody": {
                "content": {
                  "application/json": {
                    "example": {
                      "endDate": "2026-08-31T23:59:59Z",
                      "startDate": "2026-08-13T00:00:00Z"
                    },
                    "schema": {
                      "title": "Reporting Window Override",
                      "type": "object",
                      "required": [
                        "startDate",
                        "endDate"
                      ],
                      "properties": {
                        "startDate": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Inclusive start of the reporting window. Must not be after endDate."
                        },
                        "endDate": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Inclusive end of the reporting window."
                        }
                      }
                    }
                  }
                },
                "required": true
              },
              "responses": {
                "204": {
                  "description": "Reporting-window override created or updated."
                },
                "400": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "oneOf": [
                          {
                            "title": "Bad Request (General Issue)",
                            "type": "object",
