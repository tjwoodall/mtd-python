          "/marriage-allowance-test-support/sa/{utr}/status/{taxYear}": {
            "post": {
              "deprecated": false,
              "description": "Lets you create Marriage Allowance status test data.\n\nSupports the [Get Marriage Allowance status resource method](https://test-developer.service.hmrc.gov.uk/api-documentation/docs/api/service/marriage-allowance#_get-marriage-allowance-status_get_accordion) on the Marriage Allowance API.\n",
              "operationId": "CreateMarriageAllowancestatustestdata",
