                  "name": "utr",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "example": "2234567890"
                  },
                  "style": "simple"
                },
                {
                  "description": "The tax year for which the Marriage Allowance status is being created.",
                  "in": "path",
                  "name": "taxYear",
                  "required": true,
                  "schema": {
                    "pattern": "^[0-9]{4}-[0-9]{2}$",
                    "type": "string",
                    "example": "2016-17"
                  },
                  "style": "simple"
                }
              ],
              "requestBody": {
                "content": {
