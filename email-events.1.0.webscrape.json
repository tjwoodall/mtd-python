                    "application/json": {
                      "schema": {
                        "type": "object"
                      }
                    }
                  },
                  "description": "Internal server error"
                },
                "403": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "HTTPS_REQUIRED",
                              "RESOURCE_FORBIDDEN",
                              "INVALID_SCOPE",
                              "FORBIDDEN"
