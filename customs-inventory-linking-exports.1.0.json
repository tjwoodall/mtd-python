          "/customs/inventory-linking/exports": {
            "post": {
              "deprecated": false,
              "description": "Submit an Inventory Exports Request\n#### Authorisation\nThis endpoint is [user-restricted](https://developer.service.hmrc.gov.uk/api-documentation/docs/authorisation/user-restricted-endpoints) and requires an Authorization header containing an OAuth 2.0 Bearer Token with the write:customs-inventory-linking-exports scope.\n\nSee also [fraud prevention](https://developer.service.hmrc.gov.uk/guides/fraud-prevention/).",
              "operationId": "InventoryExportsRequest",
              "parameters": [
                {
                  "description": "Specifies the version of the API that you want to call. See [versioning](https://developer.service.hmrc.gov.uk/api-documentation/docs/reference-guide#versioning).",
                  "in": "header",
                  "name": "Accept",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "example": "application/vnd.hmrc.1.0+xml"
                  }
                },
                {
                  "description": "Specifies the format of the request body. Must be \"application/xml; charset=UTF-8\" or the request will be rejected with HTTP status code 415.",
                  "in": "header",
                  "name": "Content-Type",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "example": "application/xml; charset=UTF-8"
                  }
                },
                {
                  "description": "Represents the end-user who is interacting with the subscribed application.\nMust be 6 to 12 characters, consisting of any combination of numeric digits and/or upper-case letters.\n",
                  "in": "header",
                  "name": "X-Badge-Identifier",
                  "required": false,
                  "schema": {
                    "type": "string",
                    "example": "ABC123"
                  }
                },
                {
                  "description": "The EORI associated with the originating owner of the declaration.\nMust have a maximum length of 17 characters, consisting of any combination of numeric digits and/or letters.\n",
                  "in": "header",
                  "name": "X-Submitter-Identifier",
                  "required": false,
                  "schema": {
                    "type": "string",
                    "example": "ABC123"
                  }
                }
              ],
              "requestBody": {
                "content": {
                  "application/xml": {
                    "examples": {
                      "consolidationRequest": {
                        "summary": "A sample Inventory Linking Consolidation Request",
                        "value": "<!-- CST \u2013 A Consolidation message is used to shut MUCR prior to departure -->\n<inv:inventoryLinkingConsolidationRequest xmlns:inv=\"http://gov.uk/customs/inventoryLinking/v1\">\n  <inv:messageCode>CST</inv:messageCode>\n  <!--Maritime MUCR assigned to the consignment. Arriving at MUCR level. This value has come from Declaration -->\n  <inv:masterUCR>GB/123456789012-0203N1</inv:masterUCR>\n</inv:inventoryLinkingConsolidationRequest>\n"
                      },
                      "movementRequest": {
                        "summary": "A sample Inventory Linking Movement Request",
                        "value": "<!-- EAL \u2013 Movement message notification format for Entry arriving at location (Arrivals) -->\n<inv:inventoryLinkingMovementRequest xmlns:inv=\"http://gov.uk/customs/inventoryLinking/v1\">\n  <inv:messageCode>EAL</inv:messageCode>\n  <inv:ucrBlock>\n    <!--Air time MUCR assigned to the consignment. Arriving at MUCR level. This value has come from Declaration -->\n    <inv:ucr>GB/123456789012-0203N1</inv:ucr>\n    <inv:ucrType>M</inv:ucrType>\n  </inv:ucrBlock>\n  <!-- ID to give a unique position of the location. DVRDOVDVR Indicating Dover. This value has come from Declaration -->\n  <inv:goodsLocation>GBAUDVRDOVDVR</inv:goodsLocation>\n  <!-- This should be today's Date -->\n  <inv:goodsArrivalDateTime>2021-03-09T08:00:00</inv:goodsArrivalDateTime>\n  <inv:movementReference>Movement14</inv:movementReference>\n  <inv:transportDetails>\n    <inv:transportID>11CSCLGLOBE</inv:transportID>\n    <inv:transportMode>1</inv:transportMode>\n    <inv:transportNationality>GB</inv:transportNationality>\n  </inv:transportDetails>\n</inv:inventoryLinkingMovementRequest>\n"
                      },
                      "queryRequest": {
                        "summary": "A sample Inventory Linking Query Request",
                        "value": "<inv:inventoryLinkingQueryRequest xmlns:inv=\"http://gov.uk/customs/inventoryLinking/v1\">\n  <inv:queryUCR>\n    <inv:ucr>GB/AAAA-00000</inv:ucr>\n    <inv:ucrPartNo>123A</inv:ucrPartNo>\n    <inv:ucrType>D</inv:ucrType>\n  </inv:queryUCR>\n</inv:inventoryLinkingQueryRequest>\n"
                      }
                    }
                  }
                },
                "description": "",
                "required": true
