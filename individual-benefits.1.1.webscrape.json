                        "invalidUtr": {
                          "description": "Invalid UTR",
                          "value": {
                            "code": "SA_UTR_INVALID",
                            "message": "The provided SA UTR is invalid"
                          }
                        }
                      },
                      "schema": {
                        "allOf": [
                          {
                            "title": "errorResponse",
                            "required": [
                              "code",
                              "message"
                            ],
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "string",
                                "description": "The error code"
                              },
                              "message": {
                                "type": "string",
                                "description": "The error message"
                              }
                            }
                          }
