{
  "common-transit-convention-guarantee-balance": {
    "2": {
      "0": {
        "components": {
          "securitySchemes": {
            "User-Restricted": {
              "description": "HMRC supports OAuth 2.0 for authenticating user restricted API requests using an OAuth 2.0 Bearer Token in the AUTHORIZATION header. See https://developer.service.hmrc.gov.uk/api-documentation/docs/authorisation/user-restricted-endpoints for details.",
              "flows": {
                "authorizationCode": {
                  "authorizationUrl": "https://api.service.hmrc.gov.uk/oauth/authorize",
                  "refreshUrl": "https://api.service.hmrc.gov.uk/oauth/refresh",
                  "scopes": {
                    "common-transit-convention-guarantee-balance": "Access all aspects of guarantee balance."
                  },
                  "tokenUrl": "https://api.service.hmrc.gov.uk/oauth/token"
                }
              },
              "type": "oauth2"
            }
          }
        },
        "info": {
          "contact": {},
          "description": "# Overview\nUse the CTC Guarantee Balance API to provide traders with up-to-date\ninformation about how much of their guarantee funds they have left to\nuse when organising transit movements. For a detailed overview of v2.0 of\nthe API, see [CTC Guarantee Balance API phase 5 service guide](/guides/ctc-guarantee-balance-phase5-service-guide).\n",
          "title": "CTC Guarantee Balance",
          "version": "2.0"
        },
        "openapi": "3.0.3",
        "paths": {
          "/customs/guarantees/{grn}/balance": {
            "post": {
              "deprecated": false,
              "description": "Get the balance associated with a guarantee reference number (GRN).",
              "operationId": "getGuaranteeBalance",
              "parameters": [
                {
                  "description": "Specifies the response format and the [version](/api-documentation/docs/reference-guide#versioning) of the API to be used.",
                  "in": "header",
                  "name": "Accept",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "enum": [
                      "application/vnd.hmrc.2.0+json"
                    ]
                  }
                },
                {
                  "description": "The media type of the request body.",
                  "in": "header",
                  "name": "Content-Type",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "enum": [
                      "application/json"
                    ]
                  }
                },
                {
                  "description": "The guarantee reference number (GRN) of the guarantee.",
                  "in": "path",
                  "name": "grn",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "pattern": "^[0-9]{2}[A-Z]{2}[A-Z0-9]{12}[0-9]$"
                  }
                }
              ],
              "requestBody": {
                "content": {
                  "application/json": {
                    "example": {
                      "accessCode": "ABC1"
                    },
                    "schema": {
                      "allOf": [
                        {
                          "title": "CustomsGuaranteesBalancesrequest",
                          "description": "A balance request for the CTC Guarantee Balance API.",
                          "required": [
                            "accessCode"
                          ],
                          "type": "object",
                          "properties": {
                            "accessCode": {
                              "maxLength": 4,
                              "minLength": 4,
                              "type": "string",
                              "description": "The `accessCode` granting access to make use of the guarantee."
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "required": true
              },
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": {
                        "_links": {
                          "self": {
                            "href": "/customs/guarantees/23GB0123456789AB2/balance"
                          }
                        },
                        "balance": 12345678.9,
                        "currency": "GBP"
                      },
                      "schema": {
                        "allOf": [
                          {
                            "title": "Balance request successful",
                            "description": "A successful balance response.",
                            "required": [
                              "balance"
                            ],
                            "type": "object",
                            "properties": {
                              "_links": {
                                "type": "object",
                                "additionalProperties": {
                                  "title": "halLink",
                                  "description": "Hypertext Application Language (HAL) link object.",
                                  "required": [
                                    "href"
                                  ],
                                  "type": "object",
                                  "properties": {
                                    "href": {
                                      "type": "string",
                                      "description": "A link to another resource."
                                    }
                                  }
                                },
                                "description": "An object containing links to other resources."
                              },
                              "_embedded": {
                                "type": "object",
                                "additionalProperties": {
                                  "title": "hal-document-schema.json",
                                  "type": "object",
                                  "description": "Hypertext Application Language (HAL) document.",
                                  "properties": {
                                    "_links": {
                                      "allOf": [
                                        {
                                          "title": "Links",
                                          "description": "An object containing links to other resources.",
                                          "type": "object",
                                          "properties": {
                                            "self": {
                                              "allOf": [
                                                {
                                                  "title": "halLink",
                                                  "description": "Hypertext Application Language (HAL) link object.",
                                                  "required": [
                                                    "href"
                                                  ],
                                                  "type": "object",
                                                  "properties": {
                                                    "href": {
                                                      "type": "string",
                                                      "description": "A link to another resource."
                                                    }
                                                  }
                                                }
                                              ],
                                              "description": "Hypertext Application Language (HAL) link object."
                                            }
                                          }
                                        }
                                      ],
                                      "description": "An object containing links to other resources."
                                    },
                                    "_embedded": {
                                      "type": "object",
                                      "additionalProperties": {},
                                      "description": "An object containing embedded resources."
                                    }
                                  }
                                },
                                "description": "An object containing embedded resources."
                              },
                              "balance": {
                                "description": "The guarantee's balance.",
                                "type": "number"
                              },
                              "currency": {
                                "pattern": "^[A-Z]{3}$",
                                "type": "string",
                                "description": "The alphanumeric 3-character ISO currency code of the currency in which the balance is held."
                              }
                            }
                          }
                        ]
                      }
                    }
                  },
                  "description": "A successful balance request response"
                },
                "400": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "oneOf": [
                          {
                            "title": "Bad Request",
                            "description": "An error in the supplied payload, or the guarantee reference number did not match the expected format.",
                            "required": [
                              "code",
                              "message"
                            ],
                            "type": "object",
                            "properties": {
                              "code": {
                                "enum": [
                                  "BAD_REQUEST"
                                ],
                                "type": "string"
                              },
                              "message": {
                                "type": "string",
                                "description": "The description of the error."
                              }
                            },
                            "example": {
                              "code": "BAD_REQUEST",
                              "message": "The access code was not supplied."
                            }
                          },
                          {
                            "title": "Invalid Guarantee Type",
                            "description": "The supplied guarantee reference number refers to a guarantee that is not type 0, 1 or 9, and so a balance could not be obtained.",
                            "required": [
                              "code",
                              "message"
                            ],
                            "type": "object",
                            "properties": {
                              "code": {
                                "enum": [
                                  "INVALID_GUARANTEE_TYPE"
                                ],
                                "type": "string"
                              },
                              "message": {
                                "type": "string",
                                "description": "The description of the error."
                              }
                            },
                            "example": {
                              "code": "INVALID_GUARANTEE_TYPE",
                              "message": "Guarantee type is not supported."
                            }
                          }
                        ]
                      }
                    }
                  },
                  "description": "Bad request or invalid guarantee type"
                },
                "404": {
                  "content": {
                    "application/json": {
                      "example": {
                        "code": "NOT_FOUND",
                        "message": "The guarantee reference number or access code did not match an existing guarantee."
                      },
                      "schema": {
                        "allOf": [
                          {
                            "title": "NotFound",
                            "description": "A guarantee was not found that matched the supplied guarantee reference number and access code.",
