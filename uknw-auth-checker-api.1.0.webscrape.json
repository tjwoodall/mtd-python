{
  "uknw-auth-checker-api": {
    "1": {
      "0": {
        "components": {
          "securitySchemes": {
            "Application-Restricted": {
              "description": "HMRC supports OAuth 2.0 for authenticating application restricted API requests using an OAuth 2.0 Bearer Token in the AUTHORIZATION header.\nSee https://developer.service.hmrc.gov.uk/api-documentation/docs/authorisation/application-restricted-endpoints for details.\n",
              "flows": {
                "clientCredentials": {
                  "scopes": {},
                  "tokenUrl": "https://api.service.hmrc.gov.uk/oauth/token"
                }
              },
              "type": "oauth2"
            }
          }
        },
        "info": {
          "contact": {},
          "description": "This API enables Community System Providers (CSPs) and software developers to check if traders have a valid Notification of Presentation (NOP) waiver authorisation, using their EORI number. \nThis waiver is necessary to enable the transit of Not At Risk (NAR) goods moving through from Great Britain (GB) to Northern Ireland (NI). \nThe API follows RESTful principles and has a single POST method endpoint that returns the data in JSON format. It uses standard HTTP error response codes.\n\nUse this API to request the NOP waiver authorisation status of between 1 and 3000 EORI numbers passed as an array. \n\n**Note:** The API endpoint relates only to GB and NI.\n",
          "title": "Notification of Presentation Waiver Checker API",
          "version": "1.0.0"
        },
        "openapi": "3.0.3",
        "paths": {
          "/customs/uk-notice-of-presentation-waiver/authorisations": {
            "post": {
              "description": "Use this endpoint to request the NOP waiver authorisation status of between 1 and 3000 EORI numbers.\n",
              "operationId": "requestAuth",
              "parameters": [
                {
                  "description": "Specifies the response format and the [version](/api-documentation/docs/reference-guide#versioning) of the API to be used.",
                  "in": "header",
                  "name": "Accept",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "enum": [
                      "application/vnd.hmrc.1.0+json"
                    ]
                  }
                },
                {
                  "description": "The media type of the request body.",
                  "in": "header",
                  "name": "Content-Type",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "enum": [
                      "application/json"
                    ]
                  }
                }
              ],
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": [
                        "eoris"
                      ],
                      "properties": {
                        "eoris": {
                          "description": "An identifier for the business, unique to the customer.\n",
                          "type": "array",
                          "pattern": "^(GB|XI)[0-9]{12}|(GB|XI)[0-9]{15}$",
                          "items": {
                            "type": "string",
                            "example": "GB123123123333"
                          }
                        }
                      }
                    }
                  }
                },
                "description": "The payload of the API request. \n",
                "required": true
              },
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": "string",
                            "format": "date-time",
                            "example": "2024-02-01T14:15:22Z"
                          },
                          "eoris": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "eori": {
                                  "type": "string",
                                  "example": "GB123123123123"
                                },
                                "authorised": {
                                  "type": "boolean",
                                  "example": true
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "description": "Success - Authorised. A list of EORI numbers provided with their authorised status as boolean 'true' or 'false'.\n"
                },
                "400": {
                  "content": {
                    "application/json": {
                      "examples": {
                        "multiple_errors_eoris": {
                          "value": {
                            "code": "BAD_REQUEST",
                            "errors": [
                              {
                                "code": "INVALID_FORMAT",
                                "message": "ABCDEFGHIJK is not a supported EORI number",
                                "path": "eoris"
                              },
                              {
                                "code": "INVALID_FORMAT",
                                "message": "LMNOPQRSTUV is not a supported EORI number",
                                "path": "eoris"
                              }
                            ],
                            "message": "Bad request"
                          }
                        },
                        "multiple_errors_path_missing": {
                          "value": {
                            "code": "BAD_REQUEST",
                            "errors": [
                              {
                                "code": "INVALID_FORMAT",
                                "message": "eoris field missing from JSON",
                                "path": "eoris"
                              }
                            ],
                            "message": "Bad request"
                          }
                        },
                        "single_error_eoris": {
                          "value": {
                            "code": "BAD_REQUEST",
                            "errors": [
                              {
                                "code": "INVALID_FORMAT",
                                "message": "ABCDEFGHIJK is not a supported EORI number",
                                "path": "eoris"
                              }
                            ],
                            "message": "Bad request"
                          }
                        },
                        "single_error_json_structure_incorrect": {
                          "value": {
                            "code": "BAD_REQUEST",
                            "errors": [
                              {
                                "code": "INVALID_FORMAT",
                                "message": "JSON structure is incorrect",
                                "path": ""
                              }
                            ],
                            "message": "Bad request"
                          }
                        }
                      },
                      "schema": {
                        "type": "object",
                        "required": [
                          "code",
                          "message"
                        ],
                        "properties": {
