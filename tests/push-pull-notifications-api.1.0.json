  "start": "Get test-user",

  "Get test-user": {
    "subtask": "Get test business user 0 on sheet business-user-0",
    "press": [
       ["GOTO", "setup"]
    ]
  },

  "setup": {
    "include": "tests/example/push-pull-notifications-api.1.0._misc_push-pull-notification_box_{boxId}_notifications-get.example.json",
    "press": [
      ["GENSHEET", "push-pull-notifications-api.1.0"],
      ["COPY", "business-user-0", "", "json", "userId"],
      ["EDIT", "push-pull-notifications-api.1.0", "", "_control", "_username", "_PASTE"],
      ["ADD", "push-pull-notifications-api.1.0", "", "_control", "_userId"],
      ["COPY", "business-user-0", "", "json", "userId"],
      ["EDIT", "push-pull-notifications-api.1.0", "", "_control", "_userId", "_PASTE"],
      ["ADD", "push-pull-notifications-api.1.0", "", "_control", "_password"],
      ["COPY", "business-user-0", "", "json", "password"],
      ["EDIT", "push-pull-notifications-api.1.0", "", "_control", "_password", "_PASTE"],
      ["DELETE", "push-pull-notifications-api.1.0", "", "_parameters", "status"],
      ["DELETE", "push-pull-notifications-api.1.0", "", "_parameters", "fromDate"],
      ["DELETE", "push-pull-notifications-api.1.0", "", "_parameters", "toDate"],
      ["DELETE", "push-pull-notifications-api.1.0", "", "_parameters", "count"],
      ["SUBMIT", "push-pull-notifications-api.1.0", "sheet-info"],
      ["VALIDATE", "sheet-info", "", "_control", "_response", "403"],
      ["VALIDATE", "sheet-info", "", "json", "code", "INVALID_SCOPE"],
      ["GOTO", "END"]
    ]
  }
}
