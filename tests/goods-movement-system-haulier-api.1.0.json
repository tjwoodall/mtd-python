{
  "description": "Test goods-movement-system-haulier-api request",
  "schema": "artifacts/webscrape.json",
  "config": "tests/test.db",
  "include": ["tests/include/create-business-user.json"],

  "START": {
    "press": [
      ["GOSUB", "Get test business user 0 on sheet business-user-0"],
      ["GOTO", "setup"]
    ]
  },

  "setup": {
    "include": "tests/example/goods-movement-system-haulier-api.1.0._customs_goods-movement-system_movements-get.example.json",
    "press": [
      ["GENSHEET", "goods-movement-system-haulier-api.1.0"],
      ["COPY", "business-user-0", "", "json", "userId"],
      ["EDIT", "goods-movement-system-haulier-api.1.0", "", "_control", "_username", "_PASTE"],
      ["ADD", "goods-movement-system-haulier-api.1.0", "", "_control", "_userId"],
      ["COPY", "business-user-0", "", "json", "userId"],
      ["EDIT", "goods-movement-system-haulier-api.1.0", "", "_control", "_userId", "_PASTE"],
      ["ADD", "goods-movement-system-haulier-api.1.0", "", "_control", "_password"],
      ["COPY", "business-user-0", "", "json", "password"],
      ["EDIT", "goods-movement-system-haulier-api.1.0", "", "_control", "_password", "_PASTE"],
      ["SUBMIT", "goods-movement-system-haulier-api.1.0", "sheet-info"],
      ["VALIDATE", "sheet-info", "", "_control", "_response", "200"],
      ["GOTO", "END"]
    ]
  }
