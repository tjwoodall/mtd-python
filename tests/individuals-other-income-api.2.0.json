{
  "description": "Test individuals-other-income-api STATEFUL requests",
  "schema": "artifacts/webscrape.json",
  "config": "tests/test.db",
  "include": ["tests/include/create-mtdit-user.json"],

  "START": {
    "press": [
      ["GOSUB", "Get test mtdit user 0 on sheet mtdit-user-0"],
      ["GOSUB", "Create or amend.2025", "mtdit-user-0"],
      ["GOSUB", "Retrieve.2025", "mtdit-user-0"],
      ["GOSUB", "Delete.2025", "mtdit-user-0"],
      ["GOTO", "END"]
    ]
  },

  "Create or amend.2025": {
    "include": "tests/example/individuals-other-income-api.2.0._individuals_other-income_{nino}_{taxYear}-put.example.json",
    "press": [
      ["GENSHEET", "sheet._$0_"],
      ["COPY", "_$1_", "", "json", "userId"],
      ["EDIT", "sheet._$0_", "", "_control", "_username", "_PASTE"],
      ["ADD", "sheet._$0_", "", "_control", "_userId"],
      ["COPY", "_$1_", "", "json", "userId"],
      ["EDIT", "sheet._$0_", "", "_control", "_userId", "_PASTE"],
      ["ADD", "sheet._$0_", "", "_control", "_password"],
      ["COPY", "_$1_", "", "json", "password"],
      ["EDIT", "sheet._$0_", "", "_control", "_password", "_PASTE"],

      ["COPY", "_$1_", "", "json", "nino"],
      ["EDIT", "sheet._$0_", "", "_parameters", "nino", "_PASTE"],

      ["EDIT", "sheet._$0_", "", "_parameters", "taxYear", "2025-26"],
      ["ADD", "sheet._$0_", "", "_parameters", "Gov-Test-Scenario"],
      ["EDIT", "sheet._$0_", "", "_parameters", "Gov-Test-Scenario", "STATEFUL"],

      ["SUBMIT", "sheet._$0_", "sheet-info._$0_"],
      ["VALIDATE", "sheet-info._$0_", "", "_control", "_response", "200"],
      ["GOTO", "END"]
    ]
  },

