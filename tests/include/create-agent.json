{

  "_Get agent": {
    "include": "tests/example/api-platform-test-user.1.0._create-test-user_agents-post.example.json",
    "press": [
      ["GENSHEET", "api-platform-test-user.1.0._$0_"],
      ["GOTO", "_Get _$2_ agent.1"]
    ]
  },

  "_Get cache agent.1": {
    "press": [
      ["SUBMIT", "api-platform-test-user.1.0._$0_", "_$1_"],
      ["GOTO", "END"]
    ],
    "cache": "artifacts/cache/_$1_.json"
  },

  "_Get nocache agent.1": {
    "press": [
      ["SUBMIT", "api-platform-test-user.1.0._$0_", "_$1_"],
      ["GOTO", "END"]
    ]
  },

  "Get test agent 0 on sheet agent-0": {
    "subtask": "_Get agent",
    "args": [ "agent-0", "cache" ],
    "press": [
      ["GOTO", "END"]
    ]
  },

  "Create a new test agent on sheet new-agent": {
    "subtask": "_Get agent",
    "args": [ "new-agent", "nocache" ],
    "press": [
      ["GOTO", "END"]
    ]
  }
}
