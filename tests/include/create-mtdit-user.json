  "_Add a self-employment business": {
    "description": "Add a self-employment business",
    "include": "tests/example/mtd-sa-test-support-api.1.0._individuals_self-assessment-test-support_business_{nino}-post.example.json",
    "press": [
      ["GENSHEET", "Create a Test Business._$0_"],

      ["COPY", "_$1_", "", "json", "userId"],
      ["EDIT", "Create a Test Business._$0_", "", "_control", "_username", "_PASTE"],
      ["ADD", "Create a Test Business._$0_", "", "_control", "_userId"],
      ["COPY", "_$1_", "", "json", "userId"],
      ["EDIT", "Create a Test Business._$0_", "", "_control", "_userId", "_PASTE"],
      ["ADD", "Create a Test Business._$0_", "", "_control", "_password"],
      ["COPY", "_$1_", "", "json", "password"],
      ["EDIT", "Create a Test Business._$0_", "", "_control", "_password", "_PASTE"],

      ["COPY", "_$1_", "", "json", "nino"],
      ["EDIT", "Create a Test Business._$0_", "", "_parameters", "nino", "_PASTE"],

      ["PRINT", "Create a Test Business._$0_"],

      ["EDIT", "Create a Test Business._$0_", "", "json", "typeOfBusiness", "self-employment"],
      ["EDIT", "Create a Test Business._$0_", "", "json", "tradingType", "SEbusinessTradingType"],
      ["EDIT", "Create a Test Business._$0_", "", "json", "tradingName", "SEbusinessTradingName"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "firstAccountingPeriodStartDate"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "firstAccountingPeriodEndDate"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "latencyDetails"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "quarterlyTypeChoice"],
      ["EDIT", "Create a Test Business._$0_", "", "json", "accountingType", "ACCRUALS"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "commencementDate"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "cessationDate"],
      ["EDIT", "Create a Test Business._$0_", "", "json", "businessAddressLineOne"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "businessAddressLineTwo"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "businessAddressLineThree"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "businessAddressLineFour"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "businessAddressPostcode"],
      ["EDIT", "Create a Test Business._$0_", "", "json", "businessAddressCountryCode", "IE"],

      ["SUBMIT", "Create a Test Business._$0_", "test-business._$0_"],

      ["GOTO", "END", "test-business._$0_", "", "_control", "_response", "201"]
    ]
  },

  "Get test mtdit user se and property on sheet mtdit-user-both": {
    "press": [
      ["GOSUB", "_Get mtdit user", "mtdit-user-both", "cache" ],
      ["GOTO", "Get test mtdit user se and property on sheet mtdit-user-both.1"]
    ]
  },

  "Get test mtdit user se and property on sheet mtdit-user-both.1": {
    "description": "Check if there's already businesses defined",
    "press": [
      ["GOSUB", "_Get list of businesses", "mtdit-user-both", "list businesses._$0_" ],
      ["GOTO", "END", "list businesses._$0_", "", "json", "listOfBusinesses", 2],
      ["GOTO", "Get test mtdit user se and property on sheet mtdit-user-both.3", "list businesses._$0_", "", "json", "listOfBusinesses", 1],
      ["GOTO", "Get test mtdit user se and property on sheet mtdit-user-both.2", "list businesses._$0_", "", "json", "listOfBusinesses", 0]
    ]
  },

  "Get test mtdit user se and property on sheet mtdit-user-both.2": {
    "press": [
      ["GOSUB", "_Add a self-employment business", "mtdit-user-both" ],
      ["GOTO", "Get test mtdit user se and property on sheet mtdit-user-both.3"]
    ]
  },

  "Get test mtdit user se and property on sheet mtdit-user-both.3": {
    "press": [
      ["GOSUB", "_Add a property business", "mtdit-user-both" ],
      ["GOTO", "END"]
    ]
  },

  "Create a new test mtdit user on sheet new-mtdit-user": {
    "press": [
      ["GOSUB", "_Get mtdit user", "new-mtdit-user", "nocache" ],
      ["GOTO", "END"]
    ]
  }
