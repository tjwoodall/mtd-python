{

  "_Get mtdit user": {
    "include": "tests/example/api-platform-test-user.1.0._create-test-user_individuals-post.example.json",
    "press": [
      ["GENSHEET", "api-platform-test-user.1.0._$0_"],
      ["GOTO", "_Get _$2_ mtdit user.1"]
    ]
  },

  "_Get cache mtdit user.1": {
    "press": [
      ["EDIT", "api-platform-test-user.1.0._$0_", "", "json", "serviceNames", "0", "", "mtd-income-tax"],
      ["DELETE", "api-platform-test-user.1.0._$0_", "", "json", "eoriNumber"],
      ["DELETE", "api-platform-test-user.1.0._$0_", "", "json", "nino"],
      ["SUBMIT", "api-platform-test-user.1.0._$0_", "_$1_"],
      ["GOTO", "END"]
    ],
    "cache": "artifacts/cache/_$1_.json"
  },

  "_Get nocache mtdit user.1": {
    "press": [
      ["EDIT", "api-platform-test-user.1.0._$0_", "", "json", "serviceNames", "0", "", "mtd-income-tax"],
      ["DELETE", "api-platform-test-user.1.0._$0_", "", "json", "eoriNumber"],
      ["DELETE", "api-platform-test-user.1.0._$0_", "", "json", "nino"],
      ["SUBMIT", "api-platform-test-user.1.0._$0_", "_$1_"],
      ["PRINT", "_$1_"],
      ["GOTO", "END"]
    ]
  },

  "_Get list of businesses": {
    "description": "Check if there's already a business defined",
    "note": "$1 - user sheet, $2 - target sheet",
    "include": "tests/example/business-details-api.2.0._individuals_business_details_{nino}_list-get.example.json",
    "press": [
      ["GENSHEET", "business-details-api.2.0._$0_"],
      ["COPY", "_$1_", "", "json", "nino"],
      ["EDIT", "business-details-api.2.0._$0_", "", "_parameters", "nino", "_PASTE"],
      ["COPY", "_$1_", "", "json", "userId"],
      ["EDIT", "business-details-api.2.0._$0_", "", "_control", "_username", "_PASTE"],
      ["ADD", "business-details-api.2.0._$0_", "", "_control", "_userId"],
      ["COPY", "_$1_", "", "json", "userId"],
      ["EDIT", "business-details-api.2.0._$0_", "", "_control", "_userId", "_PASTE"],
      ["ADD", "business-details-api.2.0._$0_", "", "_control", "_password"],
      ["COPY", "_$1_", "", "json", "password"],
      ["EDIT", "business-details-api.2.0._$0_", "", "_control", "_password", "_PASTE"],
      ["ADD", "business-details-api.2.0._$0_", "", "_parameters", "Gov-Test-Scenario"],
      ["EDIT", "business-details-api.2.0._$0_", "", "_parameters", "Gov-Test-Scenario", "STATEFUL"],
      ["SUBMIT", "business-details-api.2.0._$0_", "_$2_"],
      ["GOTO", "END"]
    ]
  },

  "Get test mtdit user 0 on sheet mtdit-user-0": {
    "press": [
      ["GOSUB", "_Get mtdit user", "mtdit-user-0", "cache" ],
      ["GOTO", "END"]
    ]
  },

  "Get test mtdit user property on sheet mtdit-user-prop": {
    "press": [
      ["GOSUB", "_Get mtdit user", "mtdit-user-prop", "cache" ],
      ["GOTO", "Get test mtdit user property on sheet mtdit-user-prop.1"]
    ]
  },

  "Get test mtdit user property on sheet mtdit-user-prop.1": {
    "description": "Check if there's already a business defined",
    "press": [
      ["GOSUB", "_Get list of businesses", "mtdit-user-prop", "list businesses._$0_" ],
      ["GOTO", "END", "list businesses._$0_", "", "json", "listOfBusinesses", 1],
      ["GOTO", "Get test mtdit user property on sheet mtdit-user-prop.2", "list businesses._$0_", "", "json", "listOfBusinesses", 0]
    ]
  },

  "Get test mtdit user property on sheet mtdit-user-prop.2": {
    "press": [
      ["GOSUB", "_Add a property business", "mtdit-user-prop" ],
      ["GOTO", "END"]
    ]
  },

  "_Add a property business": {
    "description": "Add a property business",
    "include": "tests/example/mtd-sa-test-support-api.1.0._individuals_self-assessment-test-support_business_{nino}-post.example.json",
    "press": [
      ["GENSHEET", "Create a Test Business._$0_"],

      ["COPY", "_$1_", "", "json", "userId"],
      ["EDIT", "Create a Test Business._$0_", "", "_control", "_username", "_PASTE"],
      ["ADD", "Create a Test Business._$0_", "", "_control", "_userId"],
      ["COPY", "_$1_", "", "json", "userId"],
      ["EDIT", "Create a Test Business._$0_", "", "_control", "_userId", "_PASTE"],
      ["ADD", "Create a Test Business._$0_", "", "_control", "_password"],
      ["COPY", "_$1_", "", "json", "password"],
      ["EDIT", "Create a Test Business._$0_", "", "_control", "_password", "_PASTE"],

      ["COPY", "_$1_", "", "json", "nino"],
      ["EDIT", "Create a Test Business._$0_", "", "_parameters", "nino", "_PASTE"],

      ["EDIT", "Create a Test Business._$0_", "", "json", "typeOfBusiness", "uk-property"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "tradingType"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "tradingName"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "firstAccountingPeriodStartDate"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "firstAccountingPeriodEndDate"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "latencyDetails"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "quarterlyTypeChoice"],
      ["EDIT", "Create a Test Business._$0_", "", "json", "accountingType", "ACCRUALS"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "commencementDate"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "cessationDate"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "businessAddressLineOne"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "businessAddressLineTwo"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "businessAddressLineThree"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "businessAddressLineFour"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "businessAddressPostcode"],
      ["DELETE", "Create a Test Business._$0_", "", "json", "businessAddressCountryCode"],

      ["SUBMIT", "Create a Test Business._$0_", "test-business._$0_"],

      ["GOTO", "END", "test-business._$0_", "", "_control", "_response", "201"]
    ]
  },

  "Get test mtdit user self-employment on sheet mtdit-user-se": {
    "press": [
      ["GOSUB", "_Get mtdit user", "mtdit-user-se", "cache" ],
      ["GOTO", "Get test mtdit user self-employment on sheet mtdit-user-se.1"]
    ]
  },

  "Get test mtdit user self-employment on sheet mtdit-user-se.1": {
    "description": "Check if there's already a business defined",
    "press": [
      ["GOSUB", "_Get list of businesses", "mtdit-user-se", "list businesses._$0_" ],
      ["GOTO", "END", "list businesses._$0_", "", "json", "listOfBusinesses", 1],
      ["GOTO", "Get test mtdit user self-employment on sheet mtdit-user-se.2", "list businesses._$0_", "", "json", "listOfBusinesses", 0]
    ]
  },

  "Get test mtdit user self-employment on sheet mtdit-user-se.2": {
    "press": [
      ["GOSUB", "_Add a self-employment business", "mtdit-user-se" ],
      ["GOTO", "END"]
    ]
