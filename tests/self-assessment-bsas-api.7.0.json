{
  "description": "Test self-assessment-bsas-api request",
  "schema": "artifacts/webscrape.json",
  "config": "tests/test.db",
  "include": ["tests/include/create-mtdit-user.json"],
  "start": "Get test-user",

  "Get test-user": {
    "subtask": "Get test mtdit user 0 on sheet mtdit-user-0",
    "press": [
       ["GOTO", "setup"]
    ]
  },

  "setup": {
    "include": "tests/example/self-assessment-bsas-api.7.0._individuals_self-assessment_adjustable-summary_{nino}_{taxYear}-get.example.json",
    "press": [
      ["GENSHEET", "self-assessment-bsas-api.7.0"],
      ["COPY", "mtdit-user-0", "", "json", "nino"],
      ["EDIT", "self-assessment-bsas-api.7.0", "", "_parameters", "nino", "_PASTE"],
      ["COPY", "mtdit-user-0", "", "json", "userId"],
      ["EDIT", "self-assessment-bsas-api.7.0", "", "_control", "_username", "_PASTE"],
      ["ADD", "self-assessment-bsas-api.7.0", "", "_control", "_userId"],
      ["COPY", "mtdit-user-0", "", "json", "userId"],
      ["EDIT", "self-assessment-bsas-api.7.0", "", "_control", "_userId", "_PASTE"],
      ["ADD", "self-assessment-bsas-api.7.0", "", "_control", "_password"],
      ["COPY", "mtdit-user-0", "", "json", "password"],
      ["EDIT", "self-assessment-bsas-api.7.0", "", "_control", "_password", "_PASTE"],
      ["EDIT", "self-assessment-bsas-api.7.0", "", "_parameters", "taxYear", "2026-27"],
      ["SUBMIT", "self-assessment-bsas-api.7.0", "sheet-info"],
      ["VALIDATE", "sheet-info", "", "_control", "_response", "200"],
      ["VALIDATE", "sheet-info", "", "json", "", "businessSources", "0", "", "typeOfBusiness", "self-employment"],
      ["GOTO", "END"]
    ]
  }
}
