{
  "description": "Test individuals-expenses-api request",
  "schema": "artifacts/webscrape.json",
  "config": "tests/test.db",
  "include": ["tests/include/create-mtdit-user.json"],
  "start": "Get test-user",

  "Get test-user": {
    "subtask": "Get test mtdit user 0 on sheet mtdit-user-0",
    "press": [
       ["GOTO", "setup"]
    ]
  },

  "setup": {
    "include": "tests/example/individuals-expenses-api.3.0._individuals_expenses_employments_{nino}_{taxYear}-get.example.json",
    "press": [
      ["GENSHEET", "individuals-expenses-api.3.0"],
      ["COPY", "mtdit-user-0", "", "json", "nino"],
      ["EDIT", "individuals-expenses-api.3.0", "", "_parameters", "nino", "_PASTE"],
      ["COPY", "mtdit-user-0", "", "json", "userId"],
      ["EDIT", "individuals-expenses-api.3.0", "", "_control", "_username", "_PASTE"],
      ["ADD", "individuals-expenses-api.3.0", "", "_control", "_userId"],
      ["COPY", "mtdit-user-0", "", "json", "userId"],
      ["EDIT", "individuals-expenses-api.3.0", "", "_control", "_userId", "_PASTE"],
      ["ADD", "individuals-expenses-api.3.0", "", "_control", "_password"],
      ["COPY", "mtdit-user-0", "", "json", "password"],
      ["EDIT", "individuals-expenses-api.3.0", "", "_control", "_password", "_PASTE"],
      ["EDIT", "individuals-expenses-api.3.0", "", "_parameters", "taxYear", "2026-27"],
      ["SUBMIT", "individuals-expenses-api.3.0", "sheet-info"],
      ["VALIDATE", "sheet-info", "", "_control", "_response", "200"],
      ["VALIDATE", "sheet-info", "", "json", "expenses", "businessTravelCosts", 326.71],
      ["GOTO", "END"]
    ]
  }
}
