{
  "description": "Retrieve Winter Fuel Payment",
  "schema": "artifacts/webscrape.json",
  "config": "tests/test.db",
  "include": ["tests/include/create-mtdit-user.json"],

  "START": {
    "press": [
      ["GOSUB", "Get test mtdit user 0 on sheet mtdit-user-0"],
      ["GOTO", "run"]
    ]
  },

  "run": {
    "include": "tests/example/individuals-charges-api.3.0._individuals_charges_winter-fuel-payment_{nino}_{taxYear}-get.example.json",
    "press": [
      ["GENSHEET", "sheet._$0_"],
      ["COPY", "mtdit-user-0", "", "json", "userId"],
      ["EDIT", "sheet._$0_", "", "_control", "_username", "_PASTE"],
      ["ADD", "sheet._$0_", "", "_control", "_userId"],
      ["COPY", "mtdit-user-0", "", "json", "userId"],
      ["EDIT", "sheet._$0_", "", "_control", "_userId", "_PASTE"],
      ["ADD", "sheet._$0_", "", "_control", "_password"],
      ["COPY", "mtdit-user-0", "", "json", "password"],
      ["EDIT", "sheet._$0_", "", "_control", "_password", "_PASTE"],

      ["COPY", "mtdit-user-0", "", "json", "nino"],
      ["EDIT", "sheet._$0_", "", "_parameters", "nino", "_PASTE"],
      ["EDIT", "sheet._$0_", "", "_parameters", "taxYear", "2026-27"],

      ["GOSUB", "CannedResponse", "sheet._$0_", "hmrc-held"],
      ["GOSUB", "CannedResponse", "sheet._$0_", "user"],
      ["GOSUB", "CannedResponse", "sheet._$0_", "latest"],

      ["ADD", "sheet._$0_", "", "_parameters", "Gov-Test-Scenario"],
      ["GOSUB", "ErrorChecker", "sheet._$0_", "NOT_FOUND", "404", "MATCHING_RESOURCE_NOT_FOUND", "Matching resource not found"],
      ["GOTO", "END"]
    ]
  },

  "CannedResponse": {
    "press": [
      ["EDIT", "_$1_", "", "_parameters", "source", "_$2_"],

      ["SUBMIT", "_$1_", "sheet-info._$0_"],
      ["GOTO", "END", "sheet-info._$0_", "", "_control", "_response", "200"]
    ]
  },

  "ErrorChecker": {
    "press": [
      ["EDIT", "_$1_", "", "_parameters", "Gov-Test-Scenario", "_$2_"],
      ["SUBMIT", "_$1_", "response._$0_"],
      ["VALIDATE", "response._$0_", "", "_control", "_response", "_$3_"],
      ["VALIDATE", "response._$0_", "", "json", "code", "_$4_"],
      ["VALIDATE", "response._$0_", "", "json", "message", "_$5_"],
      ["GOTO", "END"]
    ]
  }
}
