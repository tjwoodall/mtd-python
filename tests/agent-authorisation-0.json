{
  "description": "Link mtdit user 0 to agent 0 as main agent",
  "schema": "artifacts/webscrape.json",
  "config": "tests/test.db",
  "include": ["tests/include/create-mtdit-user.json", "tests/include/create-agent.json"],
  "start": "Get test-user",

  "Get test-user": {
    "subtask": "Get test mtdit user 0 on sheet mtdit-user-0",
    "press": [
       ["GOTO", "Get test-agent"]
    ]
  },

  "Get test-agent": {
    "subtask": "Get test agent 0 on sheet agent-0",
    "press": [
       ["GOTO", "setup"]
    ]
  },

  "setup": {
    "include": "tests/example/agent-authorisation-api.1.0._agents_{arn}_invitations-post.example.json",
    "press": [
      ["GENSHEET", "agent-authorisation-api.1.0"],
      ["ADD", "agent-authorisation-api.1.0", "", "_parameters", "nino"],
      ["COPY", "mtdit-user-0", "", "json", "nino"],
      ["EDIT", "agent-authorisation-api.1.0", "", "_parameters", "nino", "_PASTE"],
      ["COPY", "agent-0", "", "json", "agentServicesAccountNumber"],
      ["EDIT", "agent-authorisation-api.1.0", "", "_parameters", "arn", "_PASTE"],
      ["COPY", "agent-0", "", "json", "userId"],
      ["EDIT", "agent-authorisation-api.1.0", "", "_control", "_username", "_PASTE"],
      ["ADD", "agent-authorisation-api.1.0", "", "_control", "_userId"],
      ["COPY", "agent-0", "", "json", "userId"],
      ["EDIT", "agent-authorisation-api.1.0", "", "_control", "_userId", "_PASTE"],
      ["ADD", "agent-authorisation-api.1.0", "", "_control", "_password"],
      ["COPY", "agent-0", "", "json", "password"],
      ["EDIT", "agent-authorisation-api.1.0", "", "_control", "_password", "_PASTE"],
      ["COPY", "mtdit-user-0", "", "json", "nino"],
      ["EDIT", "agent-authorisation-api.1.0", "", "json", "", "clientId", "_PASTE"],
      ["COPY", "mtdit-user-0", "", "json", "individualDetails", "address", "postcode"],
      ["EDIT", "agent-authorisation-api.1.0", "", "json", "", "knownFact", "_PASTE"],
      ["SUBMIT", "agent-authorisation-api.1.0", "agent-auth-req"],
      ["GOTO", "accept request", "agent-auth-req", "", "_control", "_response", "204"],
      ["GOTO", "duplicate request handler - cancel request", "agent-auth-req", "", "json", "code", "DUPLICATE_AUTHORISATION_REQUEST"],
      ["GOTO", "tax-calc", "agent-auth-req", "", "json", "code", "ALREADY_AUTHORISED"]
    ]
  },

  "accept request": {
    "include": "tests/example/agent-authorisation-test-support-api.1.0._agent-authorisation-test-support_invitations_{invitationId}-put.example.json",
    "press": [
      ["GENSHEET", "agent-authorisation-test-support-api.1.0"],
      ["COPY", "agent-auth-req", "", "_parameters", "Location", "value.split('/')[-1]"],
      ["EDIT", "agent-authorisation-test-support-api.1.0", "", "_parameters", "invitationId", "_PASTE"],
      ["SUBMIT", "agent-authorisation-test-support-api.1.0", "agent-auth-response"],
      ["GOTO", "tax-calc", "agent-auth-response", "", "_control", "_response", "204"]
    ]
  },

  "tax-calc": {
    "include": "tests/example/individual-calculations-api.8.0._individuals_calculations_{nino}_self-assessment_{taxYear}_{calculationId}-get.example.json",
    "press": [
      ["GENSHEET", "individual-calculations-api.8.0"],
      ["COPY", "mtdit-user-0", "", "json", "nino"],
      ["EDIT", "individual-calculations-api.8.0", "", "_parameters", "nino", "_PASTE"],
      ["ADD", "individual-calculations-api.8.0", "", "_control", "arn"],
      ["COPY", "agent-0", "", "json", "agentServicesAccountNumber"],
      ["EDIT", "individual-calculations-api.8.0", "", "_control", "arn", "_PASTE"],
      ["COPY", "agent-0", "", "json", "userId"],
      ["EDIT", "individual-calculations-api.8.0", "", "_control", "_username", "_PASTE"],
      ["ADD", "individual-calculations-api.8.0", "", "_control", "_userId"],
      ["COPY", "agent-0", "", "json", "userId"],
      ["EDIT", "individual-calculations-api.8.0", "", "_control", "_userId", "_PASTE"],
      ["ADD", "individual-calculations-api.8.0", "", "_control", "_password"],
      ["COPY", "agent-0", "", "json", "password"],
      ["EDIT", "individual-calculations-api.8.0", "", "_control", "_password", "_PASTE"],
      ["EDIT", "individual-calculations-api.8.0", "", "_parameters", "taxYear", "2026-27"],
      ["ADD", "individual-calculations-api.8.0", "", "_parameters", "Gov-Test-Scenario"],
      ["EDIT", "individual-calculations-api.8.0", "", "_parameters", "Gov-Test-Scenario", "DYNAMIC"],
      ["SUBMIT", "individual-calculations-api.8.0", "sheet-tax-calc"],
      ["VALIDATE", "sheet-tax-calc", "", "_control", "_response", "200"],
      ["VALIDATE", "sheet-tax-calc", "", "json", "TY 2026-27 onwards-3"],
      ["VALIDATE", "sheet-tax-calc", "", "json", "", "inputs", "personalInformation", "studentLoanPlan", "0", "", "planType", "plan1"],
      ["VALIDATE", "sheet-tax-calc", "", "json", "", "inputs", "personalInformation", "class2VoluntaryContributions", true],
      ["VALIDATE", "sheet-tax-calc", "", "json", "", "inputs", "personalInformation", "uniqueTaxpayerReference", "1234567890"],
      ["VALIDATE", "sheet-tax-calc", "", "json", "", "calculation", "endOfYearEstimate", "totalAllowancesAndDeductions", 5311],
      ["VALIDATE", "sheet-tax-calc", "", "json", "", "inputs", "constructionIndustryScheme", "0", "", "periodData", "0", "", "deductionAmount", 5000.99],
      ["GOTO", "END"]
    ]
  },

  "duplicate request handler - cancel request": {
    "subtask": "cancel-request",
    "press": [
       ["GOTO", "Generate an agent authorisation request"]
    ]
  },

  "cancel-request": {
    "include": "tests/example/agent-authorisation-api.1.0._agents_{arn}_invitations_{invitationId}-delete.example.json",
    "press": [
      ["GENSHEET", "agent-authorisation-api.1.0.delete"],
      ["COPY", "agent-0", "sheet-tax-calc", "json", "agentServicesAccountNumber"],
      ["EDIT", "agent-authorisation-api.1.0.delete", "sheet-tax-calc", "_parameters", "arn", "_PASTE"],
      ["ADD", "agent-authorisation-api.1.0.delete", "", "_parameters", "nino"],
      ["COPY", "mtdit-user-0", "", "json", "nino"],
      ["EDIT", "agent-authorisation-api.1.0.delete", "", "_parameters", "nino", "_PASTE"],
      ["COPY", "agent-0", "", "json", "userId"],
      ["EDIT", "agent-authorisation-api.1.0.delete", "", "_control", "_username", "_PASTE"],
      ["ADD", "agent-authorisation-api.1.0.delete", "", "_control", "_userId"],
      ["COPY", "agent-0", "", "json", "userId"],
      ["EDIT", "agent-authorisation-api.1.0.delete", "", "_control", "_userId", "_PASTE"],
      ["ADD", "agent-authorisation-api.1.0.delete", "", "_control", "_password"],
      ["COPY", "agent-0", "", "json", "password"],
      ["EDIT", "agent-authorisation-api.1.0.delete", "", "_control", "_password", "_PASTE"],
      ["COPY", "agent-auth-req", "", "_parameters", "Location", "value.split('/')[-1]"],
      ["EDIT", "agent-authorisation-api.1.0.delete", "", "_parameters", "invitationId", "_PASTE"],
      ["SUBMIT", "agent-authorisation-api.1.0.delete", "cancel-response"]
    ]
  }
}
