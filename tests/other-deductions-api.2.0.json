{
  "description": "Test other-deductions-api request",
  "schema": "artifacts/webscrape.json",
  "config": "tests/test.db",
  "include": ["tests/include/create-mtdit-user.json"],
  "start": "Get test-user",

  "Get test-user": {
    "subtask": "Get test mtdit user 0 on sheet mtdit-user-0",
    "press": [
       ["GOTO", "setup"]
    ]
  },

  "setup": {
    "include": "tests/example/other-deductions-api.2.0._individuals_deductions_other_{nino}_{taxYear}-get.example.json",
    "press": [
      ["GENSHEET", "other-deductions-api.2.0"],
      ["COPY", "mtdit-user-0", "", "json", "nino"],
      ["EDIT", "other-deductions-api.2.0", "", "_parameters", "nino", "_PASTE"],
      ["COPY", "mtdit-user-0", "", "json", "userId"],
      ["EDIT", "other-deductions-api.2.0", "", "_control", "_username", "_PASTE"],
      ["ADD", "other-deductions-api.2.0", "", "_control", "_userId"],
      ["COPY", "mtdit-user-0", "", "json", "userId"],
      ["EDIT", "other-deductions-api.2.0", "", "_control", "_userId", "_PASTE"],
      ["ADD", "other-deductions-api.2.0", "", "_control", "_password"],
      ["COPY", "mtdit-user-0", "", "json", "password"],
      ["EDIT", "other-deductions-api.2.0", "", "_control", "_password", "_PASTE"],
      ["EDIT", "other-deductions-api.2.0", "", "_parameters", "taxYear", "2026-27"],
      ["SUBMIT", "other-deductions-api.2.0", "sheet-info"],
      ["VALIDATE", "sheet-info", "", "_control", "_response", "200"],
      ["VALIDATE", "sheet-info", "", "json", "seafarers", "0", "", "amountDeducted", 2543.32],
      ["GOTO", "END"]
    ]
  }
}
