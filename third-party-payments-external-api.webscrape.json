{
  "third-party-payments-external-api": {
    "1": {
      "0": {
        "components": {
          "securitySchemes": {
            "Application-Restricted": {
              "description": "HMRC supports OAuth 2.0 for authenticating application restricted API requests using an OAuth 2.0 Bearer Token in the AUTHORIZATION header.\nSee https://developer.service.hmrc.gov.uk/api-documentation/docs/authorisation/application-restricted-endpoints for details.\n",
              "flows": {
                "clientCredentials": {
                  "scopes": {},
                  "tokenUrl": "https://api.service.hmrc.gov.uk/oauth/token"
                }
              },
              "type": "oauth2"
            },
            "User-Restricted": {
              "description": "HMRC supports OAuth 2.0 for authenticating user restricted API requests using an OAuth 2.0 Bearer Token in the AUTHORIZATION header.\nSee https://developer.service.hmrc.gov.uk/api-documentation/docs/authorisation/user-restricted-endpoints for details.\n",
              "flows": {
                "authorizationCode": {
                  "authorizationUrl": "https://api.service.hmrc.gov.uk/oauth/authorize",
                  "refreshUrl": "https://api.service.hmrc.gov.uk/oauth/refresh",
                  "scopes": {
                    "status": "Update the status of fraud check"
                  },
                  "tokenUrl": "https://api.service.hmrc.gov.uk/oauth/token"
                }
              },
              "type": "oauth2"
            }
          }
        },
        "info": {
          "description": "This API allows users to trigger an HMRC payment journey from their software. \n\nThe workflow enables an API user to redirect a customer through to an HMRC payment journey. \nIf an optional back-url was provided by the API user we will offer this as a link to the customer to continue their journey.\n\nAdditional details about the outcome of the payment can be discovered \nby the API user by taking advantage of the /status endpoint.\n\nTypical lifetimes for journey storage are not yet determined.\n",
          "title": "Initiate payment",
          "version": "1.0.3"
        },
        "openapi": "3.0.3",
        "paths": {
          "/pay": {
            "post": {
              "description": "After a successful call to the /pay endpoint, the API user receives JSON with a redirection URL. The API user\nthen redirects the customer's browser to this URL, starting the payment journey.\n",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "title": "Pay request schema",
                      "description": "The JSON describing an HMRC third party payment /pay payload.",
                      "type": "object",
                      "required": [
                        "taxRegime",
                        "reference",
                        "amountInPence"
                      ],
                      "properties": {
                        "taxRegime": {
                          "type": "string",
                          "description": "The tax regime under which the liability has arisen. One of a fixed set. Currently supported regimes are: Self Assessment and Vat.\n",
                          "enum": [
                            "SelfAssessment",
                            "Vat"
                          ],
                          "example": "SelfAssessment"
                        },
                        "reference": {
                          "description": "The reference identifying the tax liability. For Self Assessment this is the 10 digit Unique Taxpayer Reference. For VAT this is the 9-digit VAT registration number.",
                          "type": "string",
                          "example": "1097172564"
                        },
                        "amountInPence": {
                          "description": "The amount to be paid in pence, so \u00a312.34 is 1234, must be greater than or equal to 0. If 0 is provided, the user will be prompted to enter an amount. If non zero is provided, the user will be prompted to select the amount or enter another amount.",
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": false,
                          "example": 1234
                        },
                        "backURL": {
                          "description": "If this is present HMRC will offer this as a link to the customer at the end of the journey, this link can allow them to return to their software.",
                          "type": "string",
                          "format": "uri",
                          "example": "https://some-accounting-software.com/after-pay/a218f71d9bf2438e851c71d50866c2e9"
                        },
                        "friendlyName": {
                          "description": "The name of the software that the user started their payment from. If this is present, then we will display a link to help users go back to their software which says \"return to &lt;friendlyName&gt;\"",
                          "type": "string",
                          "example": "Accounting Software Company X"
                        }
                      }
                    }
                  }
                },
                "description": "The request body always contains the fields that allow HMRC to identify the liability that is being paid, so \nthat the funds are not mis-allocated. The required fields are the taxRegime, the reference and amountInPence.\nThe backURL is an optional field containing a url to return the user to after they finish their payment.\nThe friendlyName is an optional field to let the user know where they are being returned to after they finish their payment.\nIf a field is labeled as optional, we intend this to mean that it should be *omitted entirely* - not sent through with a null value etc.\n",
                "required": true
              },
              "responses": {
                "201": {
                  "content": {
                    "application/json": {
                      "example": {
                        "clientJourneyId": "a218f71d-9bf2-438e-851c-71d50866c2e9",
                        "redirectURL": "https://tax.gov.uk/payments/start/jhdugiuygdwuygsxajvbh"
                      },
                      "schema": {
                        "type": "object",
                        "properties": {
                          "redirectURL": {
                            "type": "string",
                            "description": "The URL to direct the customer browser to in order to initiate the customer payment journey"
                          },
                          "clientJourneyId": {
                            "type": "string",
                            "format": "uuid",
                            "description": "The client identifier created by HMRC for this journey. This will be a UUID (version 4, variant 2). This field is used to identify the journey in calls to the /status endpoint."
                          }
                        }
                      }
                    }
                  },
                  "description": "Created. Body contains url to redirect user to and a UUID to look up the status of the payment journey with."
                },
                "400": {
                  "content": {
                    "application/json": {
                      "example": {
                        "errors": [
                          "Mandatory reference field was omitted."
                        ]
                      },
                      "schema": {
                        "type": "object",
                        "properties": {
                          "errors": {
                            "type": "array",
                            "description": "The array contains the list of error messages.",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  "description": "Bad Request.\n\nA 400 response represents a malformed request. The returned JSON will attempt to guide\nthe API user to the problem.\n"
                },
                "500": {
                  "content": {
                    "application/json": {
                      "example": {
                        "errors": [
                          "Error from upstream"
                        ]
                      },
                      "schema": {
                        "type": "object",
                        "properties": {
                          "errors": {
                            "type": "array",
                            "description": "The array contains the list of error messages.",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  "description": "An error occurred upstream and could not be recovered from."
