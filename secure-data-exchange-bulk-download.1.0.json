                  "description": "UNAUTHORISED Response"
                }
              },
              "security": [
                {
                  "Application-Restricted": []
                }
              ],
              "summary": "List available files"
            },
            "parameters": [
              {
                "description": "A type of the information files to download e.g. `TARIFF-DAILY`, `TARIFF-MONTHLY`, `TARIFF-ANNUAL`.",
                "in": "path",
                "name": "fileType",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "servers": [
