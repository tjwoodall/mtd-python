                "500": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "oneOf": [
                          {
                            "properties": {
                              "code": {
                                "type": "string",
                                "description": "Error Code",
                                "enum": [
                                  "INTERNAL_SERVER_ERROR"
                                ]
                              },
                              "message": {
                                "type": "string"
                              }
                            },
                            "type": "object",
                            "example": {
                              "code": "INTERNAL_SERVER_ERROR",
