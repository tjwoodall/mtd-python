{
  "secure-data-exchange-bulk-download": {
    "1": {
      "0": {
        "components": {
          "securitySchemes": {
            "Application-Restricted": {
              "description": "HMRC supports OAuth 2.0 for authenticating application restricted API requests using an OAuth 2.0 Bearer Token in the AUTHORIZATION header.\nSee https://developer.service.hmrc.gov.uk/api-documentation/docs/authorisation/application-restricted-endpoints for details.\n",
              "flows": {
                "clientCredentials": {
                  "scopes": {},
                  "tokenUrl": "https://api.service.hmrc.gov.uk/oauth/token"
                }
              },
              "type": "oauth2"
            }
          }
        },
        "info": {
          "title": "Bulk Data File List",
          "version": "1.0"
        },
        "openapi": "3.0.0",
        "paths": {
          "/list/{fileType}": {
            "get": {
              "description": "List the files of the given type that are available for download.\n",
              "operationId": "Listavailablefiles",
              "parameters": [
                {
                  "description": "Specifies the response format and the [version](/api-documentation/docs/reference-guide#versioning) of the API to be used.",
                  "in": "header",
                  "name": "Accept",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "example": "application/vnd.hmrc.1.0+json"
                  }
                },
                {
                  "description": "An [OAuth 2.0 Bearer Token](https://developer.service.hmrc.gov.uk/api-documentation/docs/authorisation/application-restricted-endpoints) with the read:bulk-data-download-list scope.",
                  "in": "header",
                  "name": "Authorization",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "example": "Bearer 59fc92c1cdf0b8ef1f138a702effdbd2"
                  }
                }
              ],
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": [
                        {
                          "downloadURL": "https://some.sdes.domain/file1.xml.gz",
                          "fileSize": 1234,
                          "filename": "file1.xml.gz"
                        },
                        {
                          "downloadURL": "https://some.sdes.domain/file2.xml.gz",
                          "fileSize": 4321,
                          "filename": "file2.xml.gz"
                        }
                      ],
                      "schema": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "filename": {
                              "type": "string",
                              "description": "The name of the file."
                            },
                            "downloadURL": {
                              "type": "string",
                              "description": "The URL to download the file."
                            },
                            "fileSize": {
                              "type": "integer",
                              "description": "The size of the file in bytes."
                            }
                          }
                        }
                      }
                    }
                  },
                  "description": ""
                },
                "401": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "MISSING_CREDENTIALS",
                              "INVALID_CREDENTIALS",
                              "UNAUTHORIZED",
                              "INCORRECT_ACCESS_TOKEN_TYPE"
                            ]
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "type": "object",
                        "example": {
                          "code": "MISSING_CREDENTIALS",
                          "message": "Authentication information is not provided"
                        }
                      }
                    }
                  },
                  "description": "UNAUTHORISED Response"
                },
                "403": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "HTTPS_REQUIRED",
                              "RESOURCE_FORBIDDEN",
                              "INVALID_SCOPE",
                              "FORBIDDEN"
                            ]
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "type": "object",
                        "example": {
                          "code": "RESOURCE_FORBIDDEN",
                          "message": "The application is not subscribed to the API which it is attempting to invoke"
                        }
                      }
                    }
                  },
                  "description": "UNAUTHORISED Response"
                },
                "404": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "MATCHING_RESOURCE_NOT_FOUND"
                            ]
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "type": "object",
                        "example": {
                          "code": "MATCHING_RESOURCE_NOT_FOUND",
                          "message": "No endpoint for the request path"
                        }
                      }
                    }
                  },
                  "description": "UNAUTHORISED Response"
                },
                "405": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Error Code",
                            "enum": [
                              "METHOD_NOT_ALLOWED"
                            ]
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "type": "object",
                        "example": {
                          "code": "METHOD_NOT_ALLOWED",
                          "message": "Request method must be one of GET, PUT, POST, PATCH, DELETE or OPTIONS"
                        }
                      }
                    }
                  },
                  "description": "UNAUTHORISED Response"
                },
                "406": {
